{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ember-app",
  "version": "1.2.1",
  "identifier": "com.sherlyn.ember-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ember",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "visible": true
      },
      {
        "label": "pet",
        "title": "Pet",
        "url": "pet.html",
        "width": 250,
        "height": 250,
        "x": 100,
        "y": 100,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "shadow": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
    "resources": [
      "assets/**/*"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://api.github.com/repos/SherlynXia/Ember/releases/latest"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1NTNCNTA2QTU2QzVFQTMKUldTalhteWxCclZUeFlSc1BoekpwdjFyZFZBK1EwTG8vU3p2UFV6TVNCNDByL0NvOXkvb3JYUWYK"
    }
  }
}